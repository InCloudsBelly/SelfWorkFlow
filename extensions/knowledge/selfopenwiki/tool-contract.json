{
  "schemaVersion": 1,
  "backend": "selfopenwiki",
  "status": {
    "firstCall": "openwiki_status",
    "required": {
      "version.contractSchema": 2,
      "executionMode": "external_agent",
      "authRequired": false
    },
    "publicationRequired": {
      "externalAgent.ready": true,
      "capabilities": [
        "update.external-agent.begin",
        "update.external-agent.reviewed-finalize"
      ]
    }
  },
  "externalUpdate": {
    "begin": "openwiki_begin_external_update",
    "finalize": "openwiki_finalize_external_update",
    "sequence": [
      "writer-begin-start",
      "candidate-only-write",
      "prepare-review",
      "independent-reviewer",
      "reviewed-finalize-publish"
    ],
    "legacyFallback": false,
    "clarificationRequiresUserConfirmation": true,
    "technicalFailuresRequireUserDecision": false,
    "automaticCommit": false,
    "automaticPush": false
  },
  "personalLifecycle": {
    "protocol": "selfopenwiki:personal-openwiki-v1",
    "default": true,
    "overrideRouting": {
      "source": "openwiki_status.paths.wikiRoot",
      "injectOn": "openwiki_begin",
      "mismatch": "fail-closed",
      "statusRequiredBeforeEveryPersonalCall": true
    },
    "tools": [
      "openwiki_begin",
      "openwiki_submit_plan",
      "openwiki_next_page",
      "openwiki_inspect_page_claims",
      "openwiki_submit_page",
      "openwiki_finish"
    ],
    "sequence": [
      "openwiki_status",
      "openwiki_begin",
      "openwiki_submit_plan",
      "openwiki_next_page",
      "openwiki_inspect_page_claims",
      "openwiki_submit_page",
      "openwiki_finish"
    ],
    "requiredCapabilities": [
      "personal.lifecycle.begin",
      "personal.wiki-root.explicit",
      "personal.skill-adaptation.bound",
      "personal.lifecycle.plan",
      "personal.page-job.queue",
      "personal.lifecycle.next-page",
      "personal.candidate.write-package",
      "personal.claims.inspect",
      "personal.claims.binding",
      "personal.page.validate-assigned",
      "personal.claims.sparse-decisions",
      "personal.lifecycle.finish",
      "personal.c7-review-cas-publish"
    ],
    "compatibilityManifest": {
      "schemaVersion": 2,
      "protocol": "selfopenwiki:personal-openwiki-v1",
      "source": "SelfOpenWiki/config/personal-openwiki-compatibility.json"
    }
  },
  "installation": {
    "setup": ["Setup.bat"],
    "setupWithMcp": ["Setup.bat", "--with-mcp"],
    "install": [
      "Install.bat",
      "--wiki-root",
      "<absolute>",
      "--confirm-data-safety"
    ],
    "gitInstallExtra": "--confirm-git-authorization",
    "configRoot": "%LOCALAPPDATA%/SelfOpenWiki",
    "wikiGitMutation": false
  },
  "visualizer": {
    "source": "openwiki_status.visualizer",
    "requiredForDefault": true,
    "id": "selfopenwiki.zxh_wiki_viewer",
    "contractSchema": 1,
    "launcherPath": "status.visualizer.launcherPath",
    "wikiRootInput": ["--wiki-root", "<wiki-root>"],
    "urlTemplate": "http://127.0.0.1:{port}/wiki/local",
    "loopbackOnly": true,
    "autoOpen": false
  },
  "defaultRouting": {
    "profile": "knowledge",
    "backend": "selfopenwiki",
    "intents": ["wiki-visualize", "wiki-summary", "wiki-organize", "wiki-update"],
    "fallback": "forbidden"
  },
  "forbiddenPersistence": [
    "personal wiki path",
    "private receipt",
    "local runtime evidence",
    "credentials"
  ]
}
