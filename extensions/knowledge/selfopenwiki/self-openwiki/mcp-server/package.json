{
  "name": "self-openwiki-mcp",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "bin": {
    "self-openwiki-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:win32-helper": "dotnet publish ../win32-helper-compat/SelfOpenWiki.Win32Helper.csproj --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=true --output ../win32-helper/dist",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "pretest": "corepack pnpm@10.33.2 --dir ../.. run materialize:openwiki && corepack pnpm@10.33.2 --dir ../../.work/openwiki run build && corepack pnpm@10.33.2 build && corepack pnpm@10.33.2 run build:win32-helper",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ignore": "7.0.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "prettier": "3.8.4",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  }
}
