+async function createPolicyFixture(): Promise<PolicyFixture> {
+  const tempDir = await mkdtemp(path.join(os.tmpdir(), "openwiki-policy-"));
+  tempDirs.push(tempDir);
+  const rootDir = path.join(tempDir, "agent-root");
+  const wikiDir = path.join(rootDir, "wiki");
+  const sourceDir = path.join(rootDir, "sources");
+  const skillsDir = path.join(rootDir, "skills");
+  const controlDir = path.join(rootDir, "control");
+  const policyPath = path.join(tempDir, "run-policy.json");
+
+  await Promise.all(
+    [rootDir, wikiDir, sourceDir, skillsDir, controlDir].map((dir) =>
+      mkdir(dir, { recursive: true }),
+    ),
+  );
+  await Promise.all([
+    writeFile(path.join(rootDir, "unmanaged.txt"), "unmanaged", "utf8"),
+    writeFile(path.join(wikiDir, "page.md"), "wiki", "utf8"),
+    writeFile(path.join(sourceDir, "code.cpp"), "source", "utf8"),
+    writeFile(path.join(skillsDir, "SKILL.md"), "skill", "utf8"),
+  ]);
+
+  return {
+    controlDir,
+    policyPath,
+    rootDir,
+    skillsDir,
+    sourceDir,
+    tempDir,
+    wikiDir,
+  };
+}
+
+async function createPolicyBackend(
+  fixture: PolicyFixture,
+): Promise<OpenWikiLocalShellBackend> {
+  process.env[OPENWIKI_RUN_POLICY_FILE_ENV_KEY] = fixture.policyPath;
+  process.env[OPENWIKI_SHELL_MODE_ENV_KEY] = "restricted";
+  return OpenWikiLocalShellBackend.fromEnvironment({
+    rootDir: fixture.rootDir,
+    virtualMode: true,
+  });
+}
+
+function createPolicy(fixture: PolicyFixture): Record<string, unknown> {
+  return {
+    disableConnectors: true,
+    mounts: [
+      mount("wiki", fixture.wikiDir, ["read", "list"]),
+      mount("sources", fixture.sourceDir, ["read", "list"]),
+      mount("skills", fixture.skillsDir, ["read", "list"]),
+      mount("control", fixture.controlDir, ["read", "write", "list"]),
+    ],
+    rootDir: fixture.rootDir,
+    version: 1,
+  };
+}
+
+async function writePolicy(
+  fixture: PolicyFixture,
+  overrides: Record<string, unknown> = {},
+): Promise<void> {
+  await writeFile(
+    fixture.policyPath,
+    JSON.stringify({ ...createPolicy(fixture), ...overrides }, null, 2),
+    "utf8",
+  );
+}
+
+function mount(
+  id: string,
+  mountPath: string,
+  permissions: Permission[],
+): Record<string, unknown> {
+  return { id, path: mountPath, permissions };
+}
+
+function restoreEnv(key: string, value: string | undefined): void {
+  if (value === undefined) {
+    delete process.env[key];
+  } else {
+    process.env[key] = value;
+  }
+}
