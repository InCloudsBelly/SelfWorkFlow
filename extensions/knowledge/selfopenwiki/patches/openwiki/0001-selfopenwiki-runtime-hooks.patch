+
+describe("OPENWIKI_SHELL_MODE", () => {
+  test("parses restricted mode and preserves the unset default", () => {
+    expect(resolveOpenWikiShellMode({})).toBeUndefined();
+    expect(
+      resolveOpenWikiShellMode({
+        [OPENWIKI_SHELL_MODE_ENV_KEY]: "restricted",
