+      let thrown: unknown;
+
+      try {
+        resolveOpenWikiShellMode({ [OPENWIKI_SHELL_MODE_ENV_KEY]: mode });
+      } catch (error) {
+        thrown = error;
+      }
+
+      expect(thrown).toBeInstanceOf(Error);
+      const message = (thrown as Error).message;
+      expect(message).toContain(OPENWIKI_SHELL_MODE_ENV_KEY);
+      if (mode.length > 0) {
+        expect(message).not.toContain(mode);
+      }
+    },
+  );
+
+  test.each([
+    "pwd",
+    "git --no-pager rev-parse HEAD",
+    "rg secret .",
+    "powershell -NoProfile -Command Get-Content .env",
+    "cmd /c type .env",
+    "node -e \"process.stdout.write('x')\"",
+    "pwd && type .env",
+    "C:\\Windows\\System32\\cmd.exe /c dir",
+  ])(
+    "rejects every execute command in restricted mode: %s",
+    async (command) => {
+      const execute = vi
+        .spyOn(LocalShellBackend.prototype, "execute")
+        .mockResolvedValue({
+          exitCode: 0,
+          output: "unexpected",
+          truncated: false,
+        });
+      const backend = await createBackend({ shellMode: "restricted" });
+
+      await expect(backend.execute(command)).resolves.toEqual({
+        exitCode: 1,
+        output: expect.stringContaining("restricted"),
+        truncated: false,
+      });
+      expect(execute).not.toHaveBeenCalled();
+    },
+  );
+
+  test("keeps upstream execute behavior when mode is unset", async () => {
+    const execute = vi
+      .spyOn(LocalShellBackend.prototype, "execute")
+      .mockResolvedValue({ exitCode: 0, output: "upstream", truncated: false });
+    const backend = await createBackend();
+
+    await expect(backend.execute("any upstream command")).resolves.toEqual({
+      exitCode: 0,
+      output: "upstream",
+      truncated: false,
+    });
+    expect(execute).toHaveBeenCalledOnce();
+  });
+
+  test("applies the environment mode through the production backend factory", async () => {
+    process.env[OPENWIKI_SHELL_MODE_ENV_KEY] = "restricted";
+    const execute = vi
+      .spyOn(LocalShellBackend.prototype, "execute")
+      .mockResolvedValue({
+        exitCode: 0,
+        output: "unexpected",
+        truncated: false,
+      });
+    const backend = await createBackend({}, true);
+
+    const result = await backend.execute("pwd");
+
+    expect(result.exitCode).toBe(1);
+    expect(result.output).toContain("restricted");
+    expect(execute).not.toHaveBeenCalled();
+  });
+
+  test("keeps controlled filesystem tools available in restricted mode", async () => {
+    const backend = await createBackend({ shellMode: "restricted" });
+
+    const write = await backend.write("/notes.md", "before");
+    expect(write.error).toBeUndefined();
+
+    const edit = await backend.edit("/notes.md", "before", "after");
+    expect(edit.error).toBeUndefined();
+
+    const read = await backend.read("/notes.md");
+    expect(read.error).toBeUndefined();
+    expect(read.content).toContain("after");
+
+    const readRaw = await backend.readRaw("/notes.md");
+    expect(readRaw.error).toBeUndefined();
+
+    const ls = await backend.ls("/");
+    expect(ls.error).toBeUndefined();
+    expect(ls.files?.some((file) => file.path.endsWith("notes.md"))).toBe(true);
+
+    const glob = await backend.glob("**/*.md", "/");
+    expect(glob.error).toBeUndefined();
+    expect(glob.files?.some((file) => file.path.endsWith("notes.md"))).toBe(
+      true,
+    );
+
+    const grep = await backend.grep("after", "/", "*.md");
+    expect(grep.error).toBeUndefined();
+    expect(grep.matches?.some((match) => match.path.endsWith("notes.md"))).toBe(
+      true,
+    );
+  });
+
+  test("composes restricted shell with ignore and docs-only rules", async () => {
+    const rootDir = await createTempDir();
+    await writeFile(path.join(rootDir, "secret.txt"), "hidden", "utf8");
+    const backend = new OpenWikiLocalShellBackend({
+      docsOnly: true,
+      openWikiIgnore: OpenWikiIgnore.parse("secret.txt\n"),
+      rootDir,
+      shellMode: "restricted",
+      virtualMode: true,
+    });
+
+    const execute = await backend.execute("pwd");
+    expect(execute.exitCode).toBe(1);
+    expect(execute.output).toContain("restricted");
+
+    const ignoredRead = await backend.read("/secret.txt");
+    expect(ignoredRead.error).toContain(".openwikiignore");
+
+    const allowedWrite = await backend.write("/openwiki/notes.md", "ok");
+    expect(allowedWrite.error).toBeUndefined();
+
+    const blockedWrite = await backend.write("/outside.md", "bad");
+    expect(blockedWrite.error).toContain("may only write under");
+  });
+});
+
+async function createBackend(
+  options: Omit<
+    ConstructorParameters<typeof OpenWikiLocalShellBackend>[0],
+    "rootDir" | "virtualMode"
+  > = {},
+  fromEnvironment = false,
+): Promise<OpenWikiLocalShellBackend> {
+  const rootDir = await createTempDir();
+
+  if (fromEnvironment) {
+    return OpenWikiLocalShellBackend.fromEnvironment({
+      ...options,
+      rootDir,
+      virtualMode: true,
+    });
+  }
+
+  return new OpenWikiLocalShellBackend({
+    ...options,
+    rootDir,
+    virtualMode: true,
+  });
+}
+
+async function createTempDir(): Promise<string> {
+  const rootDir = await mkdtemp(path.join(os.tmpdir(), "openwiki-shell-mode-"));
+  tempDirs.push(rootDir);
+  return rootDir;
+}
