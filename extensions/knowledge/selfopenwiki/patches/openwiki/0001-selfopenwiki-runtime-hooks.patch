@@ -0,0 +1,56 @@
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+
+const OPENWIKI_HOME_ENV_KEY = "OPENWIKI_HOME";
+
+let mockedHome: string;
+
+beforeEach(() => {
+  mockedHome = path.resolve("mock-user-home");
+  delete process.env[OPENWIKI_HOME_ENV_KEY];
+  vi.resetModules();
+  vi.doMock("node:os", async () => {
+    const actual = await vi.importActual<typeof import("node:os")>("node:os");
+    const homedir = (): string => mockedHome;
+    return {
+      ...actual,
+      homedir,
+      default: { ...(actual.default as typeof import("node:os")), homedir },
+    };
+  });
+});
+
+afterEach(() => {
+  delete process.env[OPENWIKI_HOME_ENV_KEY];
+  vi.doUnmock("node:os");
+  vi.resetModules();
+});
+
+describe("OpenWiki home paths", () => {
+  test("resolves every home-derived directory from OPENWIKI_HOME", async () => {
+    const configuredHome = path.join(mockedHome, "self-openwiki", "..", "runtime");
+    process.env[OPENWIKI_HOME_ENV_KEY] = configuredHome;
+
+    const home = await import("../../src/config/openwiki-home.ts");
+    const expectedHome = path.resolve(configuredHome);
+
+    expect(home.openWikiHomeDir).toBe(expectedHome);
+    expect(home.openWikiConnectorsDir).toBe(
+      path.join(expectedHome, "connectors"),
+    );
+    expect(home.openWikiConversationHistoryDir).toBe(
+      path.join(expectedHome, "conversation_history"),
+    );
+    expect(home.openWikiLocalWikiDir).toBe(path.join(expectedHome, "wiki"));
+    expect(home.openWikiSkillsDir).toBe(path.join(expectedHome, "skills"));
+    expect(home.getConnectorDir("git-repo")).toBe(
+      path.join(expectedHome, "connectors", "git-repo"),
+    );
+  });
+
+  test("keeps the legacy user-home default when OPENWIKI_HOME is unset", async () => {
+    const home = await import("../../src/config/openwiki-home.ts");
+
+    expect(home.openWikiHomeDir).toBe(path.join(mockedHome, ".openwiki"));
+  });
+});
