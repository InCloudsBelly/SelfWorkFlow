+import { createHash } from "node:crypto";
+import {
+  closeSync,
+  existsSync,
+  fstatSync,
+  openSync,
+  readdirSync,
+  lstatSync,
+  readFileSync,
+  realpathSync,
+  statSync,
+} from "node:fs";
+import path from "node:path";
+import { z } from "zod";
+
+export type OpenWikiRunPermission = "read" | "write" | "list";
+
+type LoadedMount = {
+  id: string;
+  path: string;
+  permissions: ReadonlySet<OpenWikiRunPermission>;
+};
+
+type FileIdentity = {
+  dev: string;
+  ino: string;
+  mtimeNs: string;
+  size: string;
+};
+
+export type LoadedOpenWikiRunPolicy = {
+  disableConnectors: boolean;
+  mounts: readonly LoadedMount[];
+  policyHash: string;
+  policyIdentity: FileIdentity;
+  policyPath: string;
+  rootDir: string;
+  synchronizeWikiIndexes: boolean;
+  version: 1;
+};
+
+export type RunPolicyDecision =
+  { allowed: true } | { allowed: false; reason: string };
+
+const permissionSchema = z.enum(["read", "write", "list"]);
+const mountSchema = z.strictObject({
+  id: z.string().regex(/^[a-z][a-z0-9-]{0,63}$/u),
+  path: z.string().min(1),
+  permissions: z.array(permissionSchema).min(1),
+});
+const policySchema = z.strictObject({
+  disableConnectors: z.boolean(),
+  mounts: z.array(mountSchema).min(1),
+  rootDir: z.string().min(1),
+  synchronizeWikiIndexes: z.boolean().default(true),
+  version: z.literal(1),
+});
+
+export function loadOpenWikiRunPolicy(
+  policyPath: string,
+  rootDir: string,
+): LoadedOpenWikiRunPolicy {
+  const resolvedPolicyPath = assertAbsolutePath(policyPath, "policy file");
+  const canonicalRoot = canonicalDirectory(rootDir, "backend root");
+
+  assertNoLinkAncestors(resolvedPolicyPath, "policy file");
+  const canonicalPolicyPath = realpathSync.native(resolvedPolicyPath);
+  if (isPathWithin(canonicalRoot, canonicalPolicyPath)) {
+    throw new Error(
+      "OpenWiki run policy file must stay outside the model-visible backend root.",
+    );
+  }
+
+  const stablePolicy = readStablePolicyFile(canonicalPolicyPath);
+  const policyBytes = stablePolicy.bytes;
+  let parsedJson: unknown;
+  try {
+    parsedJson = JSON.parse(policyBytes.toString("utf8"));
+  } catch {
+    throw new Error("OpenWiki run policy is not valid JSON.");
+  }
+
+  const parsed = policySchema.safeParse(parsedJson);
+  if (!parsed.success) {
+    throw new Error("OpenWiki run policy does not match the strict schema.");
+  }
+
+  const configuredRoot = canonicalDirectory(
+    parsed.data.rootDir,
+    "policy rootDir",
+  );
+  if (!pathsEqual(configuredRoot, canonicalRoot)) {
+    throw new Error("OpenWiki run policy rootDir does not match backend root.");
+  }
+
+  const ids = new Set<string>();
+  const mounts: LoadedMount[] = parsed.data.mounts.map((mount) => {
+    if (ids.has(mount.id)) {
+      throw new Error(
+        `OpenWiki run policy has duplicate mount id: ${mount.id}`,
+      );
+    }
+    ids.add(mount.id);
+
+    if (new Set(mount.permissions).size !== mount.permissions.length) {
+      throw new Error(
+        `OpenWiki run policy mount ${mount.id} has duplicate permissions.`,
+      );
+    }
+
+    const canonicalMount = canonicalDirectory(mount.path, `mount ${mount.id}`);
+    if (!isPathWithin(canonicalRoot, canonicalMount)) {
+      throw new Error(
+        `OpenWiki run policy mount ${mount.id} must stay inside backend root.`,
+      );
+    }
+    assertNoLinkBetween(canonicalRoot, canonicalMount, `mount ${mount.id}`);
+
+    return {
+      id: mount.id,
+      path: canonicalMount,
+      permissions: new Set(mount.permissions),
+    };
+  });
+
+  for (let left = 0; left < mounts.length; left += 1) {
+    for (let right = left + 1; right < mounts.length; right += 1) {
+      const first = mounts[left];
+      const second = mounts[right];
+      if (
+        isPathWithin(first.path, second.path) ||
+        isPathWithin(second.path, first.path)
+      ) {
+        throw new Error(
+          `OpenWiki run policy mounts overlap: ${first.id} and ${second.id}.`,
+        );
+      }
+    }
+  }
+
+  return {
+    disableConnectors: parsed.data.disableConnectors,
+    mounts,
+    policyHash: hashBytes(policyBytes),
+    policyIdentity: stablePolicy.identity,
+    policyPath: canonicalPolicyPath,
+    rootDir: canonicalRoot,
+    synchronizeWikiIndexes: parsed.data.synchronizeWikiIndexes,
+    version: 1,
+  };
+}
+
+export function assertOpenWikiRunPolicyCurrent(
+  policy: LoadedOpenWikiRunPolicy,
+): void {
+  if (!policyFileMatches(policy)) {
+    throw new Error("OpenWiki run policy changed after startup.");
+  }
+}
+
+export function scopeOpenWikiRunPolicy(
+  policy: LoadedOpenWikiRunPolicy,
+  mountId: string,
+  expectedRoot: string,
+): LoadedOpenWikiRunPolicy {
+  assertOpenWikiRunPolicyCurrent(policy);
+  const mount = policy.mounts.find((entry) => entry.id === mountId);
+  if (!mount) {
+    throw new Error(`OpenWiki run policy is missing mount: ${mountId}`);
+  }
+
+  const canonicalExpectedRoot = canonicalDirectory(
+    expectedRoot,
+    `mounted backend ${mountId}`,
+  );
+  if (!pathsEqual(mount.path, canonicalExpectedRoot)) {
+    throw new Error(
+      `OpenWiki run policy mount ${mountId} does not match its backend root.`,
+    );
+  }
+
+  return {
+    ...policy,
+    mounts: [mount],
+    rootDir: mount.path,
+  };
+}
+
+export function checkOpenWikiRunPolicy(
+  policy: LoadedOpenWikiRunPolicy,
+  virtualPath: string,
+  permission: OpenWikiRunPermission,
+): RunPolicyDecision {
+  if (!policyFileMatches(policy)) {
+    return {
+      allowed: false,
+      reason: "OpenWiki run policy changed after startup; refusing access.",
+    };
+  }
+
+  const candidate = resolveVirtualPath(policy.rootDir, virtualPath);
+  if (candidate === null) {
+    return denied(virtualPath);
+  }
+
+  const mount = policy.mounts.find((entry) =>
+    isPathWithin(entry.path, candidate),
+  );
+  if (!mount || !mount.permissions.has(permission)) {
+    return denied(virtualPath);
+  }
+
+  try {
+    assertNoLinkBetween(policy.rootDir, candidate, "requested path");
+    const canonicalCandidate = canonicalizeWithMissingTail(candidate);
+    if (!isPathWithin(mount.path, canonicalCandidate)) {
+      return denied(virtualPath);
+    }
+  } catch {
+    return denied(virtualPath);
+  }
+
+  return { allowed: true };
+}
+
+function denied(virtualPath: string): RunPolicyDecision {
+  return {
+    allowed: false,
+    reason: `Path is denied by OpenWiki run policy: ${virtualPath}`,
+  };
+}
+
+function policyFileMatches(policy: LoadedOpenWikiRunPolicy): boolean {
+  try {
+    const current = readStablePolicyFile(policy.policyPath);
+    return (
+      identitiesEqual(current.identity, policy.policyIdentity) &&
+      hashBytes(current.bytes) === policy.policyHash
+    );
+  } catch {
+    return false;
+  }
+}
+
+function readStablePolicyFile(policyPath: string): {
+  bytes: Buffer;
+  identity: FileIdentity;
+} {
+  const pathStatBefore = lstatSync(policyPath, { bigint: true });
+  if (!pathStatBefore.isFile() || pathStatBefore.isSymbolicLink()) {
+    throw new Error("OpenWiki run policy must be a regular non-link file.");
+  }
+
+  const fileDescriptor = openSync(policyPath, "r");
+  try {
+    const handleStatBefore = fstatSync(fileDescriptor, { bigint: true });
+    if (!handleStatBefore.isFile()) {
+      throw new Error("OpenWiki run policy handle is not a regular file.");
+    }
+    const bytes = readFileSync(fileDescriptor);
+    const handleStatAfter = fstatSync(fileDescriptor, { bigint: true });
+    const pathStatAfter = lstatSync(policyPath, { bigint: true });
+    const identity = identityFromStat(handleStatBefore);
+
+    if (
+      !identitiesEqual(identity, identityFromStat(handleStatAfter)) ||
+      !identitiesEqual(identity, identityFromStat(pathStatBefore)) ||
+      !identitiesEqual(identity, identityFromStat(pathStatAfter))
+    ) {
+      throw new Error("OpenWiki run policy changed while it was read.");
+    }
+
+    return { bytes, identity };
+  } finally {
+    closeSync(fileDescriptor);
+  }
+}
+
+function identityFromStat(stat: {
+  dev: bigint;
+  ino: bigint;
+  mtimeNs: bigint;
+  size: bigint;
+}): FileIdentity {
+  return {
+    dev: stat.dev.toString(),
+    ino: stat.ino.toString(),
+    mtimeNs: stat.mtimeNs.toString(),
+    size: stat.size.toString(),
+  };
+}
+
+function identitiesEqual(left: FileIdentity, right: FileIdentity): boolean {
+  return (
+    left.dev === right.dev &&
+    left.ino === right.ino &&
+    left.mtimeNs === right.mtimeNs &&
+    left.size === right.size
+  );
+}
+
+export function checkOpenWikiRunPolicyTree(
+  policy: LoadedOpenWikiRunPolicy,
+  virtualRoot: string,
+  permissions: readonly OpenWikiRunPermission[],
+): RunPolicyDecision {
+  for (const permission of permissions) {
+    const decision = checkOpenWikiRunPolicy(policy, virtualRoot, permission);
+    if (!decision.allowed) {
+      return decision;
+    }
+  }
+
+  const candidate = resolveVirtualPath(policy.rootDir, virtualRoot);
+  if (candidate === null || !existsSync(candidate)) {
+    return denied(virtualRoot);
+  }
+
+  try {
+    assertTreeContainsNoLinks(candidate);
+  } catch {
+    return denied(virtualRoot);
+  }
+
+  return { allowed: true };
+}
+
+export function isOpenWikiRunPolicyDiscoveryResultAllowed(
+  policy: LoadedOpenWikiRunPolicy,
+  resultPath: string,
+  searchRoot: string,
+  permission: OpenWikiRunPermission,
+): boolean {
+  if (checkOpenWikiRunPolicy(policy, resultPath, permission).allowed) {
+    return true;
+  }
+
+  const normalized = resultPath.replace(/\\/gu, "/");
+  if (
+    normalized.startsWith("//") ||
+    /^(?:\/?[a-z]:|\/?\?|\/?\.)/iu.test(normalized)
+  ) {
+    return false;
+  }
+
+  const relative = normalized.replace(/^\//, "");
+  const segments = relative.split("/");
+  if (
+    relative.length === 0 ||
+    segments.some(
+      (segment) => segment === "" || segment === "." || segment === "..",
+    )
+  ) {
+    return false;
+  }
+
+  const rootedResult = path.posix.join(
+    searchRoot.replace(/\\/gu, "/"),
+    relative,
+  );
+  const searchCandidate = resolveVirtualPath(policy.rootDir, searchRoot);
+  const resultCandidate = resolveVirtualPath(policy.rootDir, rootedResult);
+  if (
+    searchCandidate === null ||
+    resultCandidate === null ||
+    !existsSync(resultCandidate)
+  ) {
+    return false;
+  }
+
+  const searchMount = findMount(policy, searchCandidate);
+  const resultMount = findMount(policy, resultCandidate);
+  return (
+    searchMount !== undefined &&
+    searchMount === resultMount &&
+    checkOpenWikiRunPolicy(policy, rootedResult, permission).allowed
+  );
+}
+
+function resolveVirtualPath(
+  rootDir: string,
+  virtualPath: string,
+): string | null {
+  if (
+    virtualPath.length === 0 ||
+    virtualPath.includes("\0") ||
+    /^(?:[a-z]:|\\\\|\/\/|\\\?\\|\\\.\\)/iu.test(virtualPath)
+  ) {
+    return null;
+  }
+
+  const relativePath = virtualPath.replace(/\\/gu, "/").replace(/^\/+/, "");
+  const candidate = path.resolve(rootDir, ...relativePath.split("/"));
+  return isPathWithin(rootDir, candidate) ? candidate : null;
+}
+
+function findMount(
+  policy: LoadedOpenWikiRunPolicy,
+  candidate: string,
+): LoadedMount | undefined {
+  return policy.mounts.find((entry) => isPathWithin(entry.path, candidate));
+}
+
+function assertTreeContainsNoLinks(root: string): void {
+  const pending = [root];
+  let visited = 0;
+
+  while (pending.length > 0) {
+    const current = pending.pop();
+    if (!current) {
+      continue;
+    }
+    visited += 1;
+    if (visited > 100_000) {
+      throw new Error("OpenWiki run-policy tree is too large to validate.");
+    }
+
+    const stat = lstatSync(current);
+    if (stat.isSymbolicLink()) {
+      throw new Error("OpenWiki run-policy tree contains a link or junction.");
+    }
+    if (!stat.isDirectory()) {
+      continue;
+    }
+
+    for (const entry of readdirSync(current, { withFileTypes: true })) {
+      pending.push(path.join(current, entry.name));
+    }
+  }
+}
+
+function canonicalizeWithMissingTail(candidate: string): string {
+  const missing: string[] = [];
+  let existing = candidate;
+
+  while (!existsSync(existing)) {
+    const parent = path.dirname(existing);
+    if (pathsEqual(parent, existing)) {
+      throw new Error("No existing ancestor for run-policy path.");
+    }
+    missing.unshift(path.basename(existing));
+    existing = parent;
+  }
+
+  return path.resolve(realpathSync.native(existing), ...missing);
+}
+
+function assertNoLinkBetween(
+  rootDir: string,
+  candidate: string,
+  label: string,
+): void {
+  if (!isPathWithin(rootDir, candidate)) {
+    throw new Error(`${label} escapes the backend root.`);
+  }
+
+  const relative = path.relative(rootDir, candidate);
+  let current = rootDir;
+  for (const segment of relative.split(path.sep).filter(Boolean)) {
+    current = path.join(current, segment);
+    if (!existsSync(current)) {
+      break;
+    }
+    if (lstatSync(current).isSymbolicLink()) {
+      throw new Error(`${label} contains a symbolic link or junction.`);
+    }
+  }
+}
+
+function canonicalDirectory(value: string, label: string): string {
+  const resolved = assertAbsolutePath(value, label);
+  let linkStat;
+  let stat;
+  try {
+    linkStat = lstatSync(resolved);
+    stat = statSync(resolved);
+  } catch {
+    throw new Error(`${label} must be an existing directory.`);
+  }
+  if (linkStat.isSymbolicLink()) {
+    throw new Error(`${label} cannot be a symbolic link or junction.`);
+  }
+  if (!stat.isDirectory()) {
+    throw new Error(`${label} must be an existing directory.`);
+  }
+  assertNoLinkAncestors(resolved, label);
+  const canonical = realpathSync.native(resolved);
+  assertNoLinkBetween(canonical, canonical, label);
+  return canonical;
+}
+
+function assertNoLinkAncestors(candidate: string, label: string): void {
+  const parsed = path.parse(path.resolve(candidate));
+  let current = parsed.root;
+  const relative = path.relative(parsed.root, candidate);
+
+  for (const segment of relative.split(path.sep).filter(Boolean)) {
+    current = path.join(current, segment);
+    if (lstatSync(current).isSymbolicLink()) {
+      throw new Error(`${label} contains a symbolic link or junction.`);
+    }
+  }
+}
+
+function assertAbsolutePath(value: string, label: string): string {
+  if (!path.isAbsolute(value)) {
+    throw new Error(`${label} must be an absolute path.`);
+  }
+  return path.resolve(value);
+}
+
+function isPathWithin(rootDir: string, candidate: string): boolean {
+  const root = normalizeForComparison(rootDir);
+  const value = normalizeForComparison(candidate);
+  return value === root || value.startsWith(`${root}${path.sep}`);
+}
+
+function pathsEqual(left: string, right: string): boolean {
+  return normalizeForComparison(left) === normalizeForComparison(right);
+}
+
+function normalizeForComparison(value: string): string {
+  const normalized = path.resolve(value).replace(/[\\/]+$/u, "");
+  return process.platform === "win32" ? normalized.toLowerCase() : normalized;
+}
+
+function hashBytes(bytes: Uint8Array): string {
+  return createHash("sha256").update(bytes).digest("hex");
+}
