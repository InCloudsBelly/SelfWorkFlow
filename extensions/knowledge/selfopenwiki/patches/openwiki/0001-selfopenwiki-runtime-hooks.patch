+  CHATGPT_EXPIRES_AT,
+] as const;
+
+type OpenAIModelForTest = {
+  clientConfig?: { fetch?: typeof fetch };
+  invocationParams(options: Record<string, never>): Record<string, unknown>;
+};
+
+let savedEnv: Record<(typeof ENV_KEYS)[number], string | undefined>;
+
+beforeEach(() => {
+  savedEnv = Object.fromEntries(
+    ENV_KEYS.map((key) => [key, process.env[key]]),
+  ) as typeof savedEnv;
+
+  delete process.env[REASONING_EFFORT_KEY];
+  process.env[OPENAI_API_KEY] = "sk-test-openai-key";
+  process.env[CHATGPT_ACCESS_TOKEN] = "test-access-token";
+  process.env[CHATGPT_REFRESH_TOKEN] = "test-refresh-token";
+  process.env[CHATGPT_ACCOUNT_ID] = "test-account-id";
+  process.env[CHATGPT_EXPIRES_AT] = String(Date.now() + 60_000);
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+
+  for (const key of ENV_KEYS) {
+    restoreEnv(key, savedEnv[key]);
+  }
+});
+
+describe("OPENWIKI_REASONING_EFFORT", () => {
+  test.each(["low", "medium", "high", "xhigh", "max", "ultra"])(
+    "forwards supported effort %s to OpenAI Responses requests",
+    (effort) => {
+      process.env[REASONING_EFFORT_KEY] = effort;
+
+      const model = createModel("openai", "gpt-5.5", 0) as OpenAIModelForTest;
+
+      expect(model.invocationParams({}).reasoning).toEqual({ effort });
+    },
+  );
+
+  test.each(["", "unknown-canary-effort"])(
+    "rejects invalid effort %j locally without echoing configured values",
+    (effort) => {
+      process.env[REASONING_EFFORT_KEY] = effort;
+
+      let thrown: unknown;
+      try {
+        createModel("openai", "gpt-5.5", 0);
+      } catch (error) {
+        thrown = error;
+      }
+
+      expect(thrown).toBeInstanceOf(Error);
+      const message = (thrown as Error).message;
+      expect(message).toContain(REASONING_EFFORT_KEY);
+      expect(message).not.toContain("sk-test-openai-key");
+      if (effort.length > 0) {
+        expect(message).not.toContain(effort);
+      }
+    },
+  );
+
+  test("preserves upstream OpenAI request parameters when unset", () => {
+    const model = createModel("openai", "gpt-5.5", 0) as OpenAIModelForTest;
+
+    expect(model.invocationParams({}).reasoning).toBeUndefined();
+  });
+
+  test("does not forward effort to a non-OpenAI Responses provider", () => {
+    process.env[REASONING_EFFORT_KEY] = "xhigh";
+
+    const model = createModel("copilot", "gpt-5.5", 0) as OpenAIModelForTest;
+
+    expect(model.invocationParams({}).reasoning).toBeUndefined();
+  });
+
+  test("sends the configured OpenAI effort in the final Responses HTTP body", async () => {
+    process.env[REASONING_EFFORT_KEY] = "xhigh";
+    const fetchMock = vi.fn(() =>
+      Promise.reject(new Error("stop after capturing OpenAI request")),
+    );
+    vi.stubGlobal("fetch", fetchMock);
+
+    const model = createModel("openai", "gpt-5.5", 0);
+
+    await expect(model.invoke("Capture this request.")).rejects.toThrow();
+
+    expect(fetchMock).toHaveBeenCalledOnce();
+    const [input, init] = fetchMock.mock.calls[0] as [
+      string | URL | Request,
+      RequestInit,
+    ];
+    const requestUrl = input instanceof Request ? input.url : String(input);
+    expect(new URL(requestUrl).pathname.endsWith("/responses")).toBe(true);
+    expect(JSON.parse(String(init.body)).reasoning).toEqual({
+      effort: "xhigh",
+    });
+  });
+
+  test("injects the configured ChatGPT effort at the final fetch boundary", async () => {
+    process.env[REASONING_EFFORT_KEY] = "xhigh";
+    const fetchMock = vi.fn(() => Promise.resolve(new Response()));
+    vi.stubGlobal("fetch", fetchMock);
+
+    const model = createModel(
+      "openai-chatgpt",
+      "gpt-5.6-sol",
+      0,
+    ) as OpenAIModelForTest;
+    const configuredFetch = model.clientConfig?.fetch;
+
+    expect(configuredFetch).toBeTypeOf("function");
+    await configuredFetch?.("https://chatgpt.com/backend-api/codex/responses", {
+      body: JSON.stringify({ input: [] }),
+      method: "POST",
+    });
+
+    const [, init] = fetchMock.mock.calls[0] as [string, RequestInit];
+    expect(JSON.parse(String(init.body)).reasoning).toEqual({
+      effort: "xhigh",
+    });
+  });
+});
+
+function restoreEnv(key: string, value: string | undefined): void {
+  if (value === undefined) {
+    delete process.env[key];
+  } else {
+    process.env[key] = value;
+  }
+}
