{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selfworkflow.local/schemas/review-model-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agents"],
  "properties": {
    "schemaVersion": {"const": 1},
    "agents": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review"],
        "properties": {
          "review": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["model", "reasoningEffort"],
                "properties": {
                  "model": {"type": "string", "minLength": 1, "maxLength": 256},
                  "reasoningEffort": {
                    "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
