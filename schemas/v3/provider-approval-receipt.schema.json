{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selfworkflow.local/schemas/v3/provider-approval-receipt.schema.json",
  "title": "SelfWorkFlow V3 provider approval receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "receiptHash", "subjectKind", "authorizationSubjectHash", "decision", "confirmationSource", "scope", "targetHashes", "issuedAt", "expiresAt", "nonce", "revocationState"],
  "properties": {"schemaVersion": {"const": 3}, "receiptHash": {"$ref": "#/$defs/hash"}, "subjectKind": {"enum": ["operation-plan", "query-plan", "provider-selection-exception"]}, "authorizationSubjectHash": {"$ref": "#/$defs/hash"}, "decision": {"const": "approved"}, "confirmationSource": {"enum": ["user-confirmation", "machine-policy", "test-fixture"]}, "optionalActorAttestationRef": {"$ref": "#/$defs/id"}, "scope": {"type": "string", "minLength": 1, "maxLength": 256}, "targetHashes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}, "issuedAt": {"type": "string", "format": "utc-date-time"}, "expiresAt": {"type": "string", "format": "utc-date-time"}, "nonce": {"$ref": "#/$defs/id"}, "revocationState": {"enum": ["active", "revoked", "expired"]}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
