{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selfworkflow.local/schemas/v3/provider-operation-receipt.schema.json",
  "title": "SelfWorkFlow V3 provider operation receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "receiptHash", "operationPlanHash", "executionNonce", "attemptRef", "providerId", "bindingSnapshotHash", "startedAt", "completedAt", "outcome", "mutationEvidenceRefs"],
  "properties": {"schemaVersion": {"const": 3}, "receiptHash": {"$ref": "#/$defs/hash"}, "operationPlanHash": {"$ref": "#/$defs/hash"}, "executionNonce": {"$ref": "#/$defs/id"}, "attemptRef": {"$ref": "#/$defs/id"}, "providerId": {"$ref": "#/$defs/id"}, "bindingSnapshotHash": {"$ref": "#/$defs/hash"}, "startedAt": {"type": "string", "format": "date-time"}, "completedAt": {"type": "string", "format": "date-time"}, "outcome": {"enum": ["succeeded", "failed", "blocked", "unverified"]}, "approvalReceiptRef": {"$ref": "#/$defs/id"}, "mutationEvidenceRefs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "outputHash": {"$ref": "#/$defs/hash"}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
