{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selfworkflow.local/schemas/v3/provider-local-config.schema.json",
  "title": "SelfWorkFlow V3 machine provider configuration",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "providers"],
  "properties": {"schemaVersion": {"const": 3}, "providers": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/provider"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "provider": {"type": "object", "additionalProperties": false, "required": ["providerId", "sourcePath", "enabled"], "properties": {"providerId": {"$ref": "#/$defs/id"}, "sourcePath": {"type": "string", "minLength": 3, "maxLength": 32767}, "enabled": {"type": "boolean"}, "projectAuthorizations": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["canonicalProjectRootHash", "approved", "expiresAt"], "properties": {"canonicalProjectRootHash": {"$ref": "#/$defs/hash"}, "approved": {"type": "boolean"}, "expiresAt": {"type": "string", "format": "date-time"}}}}}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
}
