{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selfworkflow.local/schemas/v3/review-independence-receipt.schema.json",
  "title": "SelfWorkFlow V3 review independence receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "reviewMode", "dispatchId", "forkContext", "implementationAgentIdentity", "implementationContextIdentity", "reviewerAgentIdentity", "reviewerContextIdentity", "hostAgentIdentity", "hostContextIdentity", "hostAttestationRef", "inputMode", "parentContextImported", "grillReasoningReceived", "inputSummaryHash", "designHash", "reviewerPolicyHash", "resultHash", "fallbackAuthorizationRef", "independence", "receiptHash"],
  "properties": {
    "schemaVersion": {"const": 3},
    "reviewMode": {"const": "brainstorming-cross-review"},
    "dispatchId": {"$ref": "#/$defs/id"},
    "forkContext": {"const": false},
    "implementationAgentIdentity": {"$ref": "#/$defs/id"},
    "implementationContextIdentity": {"$ref": "#/$defs/id"},
    "reviewerAgentIdentity": {"$ref": "#/$defs/id"},
    "reviewerContextIdentity": {"$ref": "#/$defs/id"},
    "hostAgentIdentity": {"$ref": "#/$defs/id"},
    "hostContextIdentity": {"$ref": "#/$defs/id"},
    "hostAttestationRef": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "inputMode": {"const": "summary-only"},
    "parentContextImported": {"const": false},
    "grillReasoningReceived": {"const": false},
    "inputSummaryHash": {"$ref": "#/$defs/hash"},
    "designHash": {"$ref": "#/$defs/hash"},
    "reviewerPolicyHash": {"$ref": "#/$defs/hash"},
    "resultHash": {"$ref": "#/$defs/hash"},
    "fallbackAuthorizationRef": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "independence": {"enum": ["independent", "unverified"]},
    "receiptHash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"independence": {"const": "independent"}}, "required": ["independence"]},
      "then": {"properties": {"hostAttestationRef": {"$ref": "#/$defs/id"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
